<?xml version="1.0" encoding="utf-8"?>
<!-- Subscriptions, queue and settings are backed up; downloaded audio is large and can be fetched again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="episodes" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="episodes" />
    </device-transfer>
</data-extraction-rules>
